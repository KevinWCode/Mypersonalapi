# Copy to .env on the server and fill in. Never commit .env.

# GitHub username whose commits are counted
GITHUB_USER=KevinWCode
# Fine-grained personal access token, read-only. Lets private-repo commits count.
GITHUB_TOKEN=

# Shared secret the phone app sends when it uploads data (any long random string)
INGEST_TOKEN=

# Where the SQLite database lives inside the container
DB_PATH=/data/personal.db

# How often collectors run, in minutes
COLLECT_EVERY_MINUTES=60
