<?xml version="1.0" encoding="utf-8"?>
<!-- Vitals widget: the day badge and the four bars, as on the Character tab. Widgets fills it in and themes it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:text="Vitals · Level 12"
            android:textAllCaps="true"
            android:textColor="@color/widget_sub"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/condition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="★ Prime Condition"
            android:textColor="@color/widget_text"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/v0_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/v0_name"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="HP"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/v0_bar"
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_weight="1"
            android:contentDescription="HP bar"
            android:scaleType="fitXY"
            android:src="@drawable/widget_bar_preview" />

        <TextView
            android:id="@+id/v0_value"
            android:layout_width="34dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="1"
            android:text="92"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/v0_tag"
            android:layout_width="92dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:text="★ Prime"
            android:textColor="@color/widget_sub"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/v1_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/v1_name"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="Stamina"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/v1_bar"
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_weight="1"
            android:contentDescription="Stamina bar"
            android:scaleType="fitXY"
            android:src="@drawable/widget_bar_preview" />

        <TextView
            android:id="@+id/v1_value"
            android:layout_width="34dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="1"
            android:text="78"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/v1_tag"
            android:layout_width="92dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:text="Steady"
            android:textColor="@color/widget_sub"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/v2_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/v2_name"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="Mana"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/v2_bar"
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_weight="1"
            android:contentDescription="Mana bar"
            android:scaleType="fitXY"
            android:src="@drawable/widget_bar_preview" />

        <TextView
            android:id="@+id/v2_value"
            android:layout_width="34dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="1"
            android:text="64"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/v2_tag"
            android:layout_width="92dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:text="Steady"
            android:textColor="@color/widget_sub"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/v3_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/v3_name"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="Focus"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/v3_bar"
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_weight="1"
            android:contentDescription="Focus bar"
            android:scaleType="fitXY"
            android:src="@drawable/widget_bar_preview" />

        <TextView
            android:id="@+id/v3_value"
            android:layout_width="34dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="1"
            android:text="81"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/v3_tag"
            android:layout_width="92dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:text="★ Prime"
            android:textColor="@color/widget_sub"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
